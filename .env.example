# Copy this file to .env and fill in your values before running
# docker-compose up -d

# Testnet RPC endpoint
RPC_URL=https://l1-rpc-proxy.testnet.nillion.network

# On-chain config contract address (check the node setup dashboard
# for the current address — this can change between testnet phases)
CONFIG_ADDRESS=0xebB338689fB32317DDFD8282F8a42dcA6271cB2d

# Path to the node's local state file (inside the container)
STATE_FILE=/data/state/node-state.json

# Data feed mode
FEED_MODE=real
